{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Odysseus",
  "version": "1.0.0",
  "identifier": "com.morgothtr.odysseus",
  "build": {
    "frontendDist": "http://127.0.0.1:7000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/backend": "backend",
      "resources/python": "python"
    },
    "windows": {
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign-windows.ps1",
          "%1"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
